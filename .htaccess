<Files "leads.csv">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect .php URLs to clean URLs
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^(.+)\.php$ $1 [R=301,L,NE]

  # Category URL
  RewriteRule ^category/([a-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]

  # Sitemap URLs
  RewriteRule ^category-sitemap\.xml$ category-sitemap.php [L]

  RewriteRule ^post-sitemap\.xml$ post-sitemap.php [L]

  # Internally load .php file for clean URLs
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^\.]+)$ $1.php [L]
</IfModule>