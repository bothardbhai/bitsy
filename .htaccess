<Files "leads.csv">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^category/([a-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]
  RewriteRule ^category-sitemap\.xml$ category-sitemap.php [L]
  RewriteRule ^post-sitemap\.xml$ post-sitemap.php [L]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^\.]+)$ $1.php [L]
</IfModule>
